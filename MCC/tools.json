t yaw and pitch angles.","inputSchema":{"type":"object","properties":{"yaw":{"type":"number"},"pitch":{"type":"number"}},"required":["yaw","pitch"]}},{"name":"mcc_inventory_window_action","description":"Perform a window action on an inventory slot.","inputSchema":{"type":"object","properties":{"inventoryId":{"type":"integer"},"slotId":{"type":"integer"},"actionType":{"description":"WindowActionType enum name, e.g. LeftClick or ShiftClick.","type":"string"}},"required":["inventoryId","slotId","actionType"]}},{"name":"mcc_materials_list","description":"List known MCC material names with optional filtering.","inputSchema":{"type":"object","properties":{"filter":{"type":["string","null"],"default":null},"maxCount":{"type":"integer","default":500}}}},{"name":"mcc_run_internal_command","description":"Run an internal MCC command.","inputSchema":{"type":"object","properties":{"command":{"description":"MCC command line without leading slash.","type":"string"}},"required":["command"]}},{"name":"mcc_raycast_block","description":"Raycast from the player\u0027s current view and return the first non-air block hit.","inputSchema":{"type":"object","properties":{"maxDistance":{"type":"number","default":8},"includeNeighbors":{"type":"boolean","default":false}}}},{"name":"mcc_look_direction","description":"Rotate player view to a cardinal direction or straight up/down.","inputSchema":{"type":"object","properties":{"direction":{"type":"string"}},"required":["direction"]}},{"name":"mcc_player_state","description":"Get current controlled player state.","inputSchema":{"type":"object","properties":{}}},{"name":"mcc_place_block","description":"Place the currently held block/item at a target block location.","inputSchema":{"type":"object","properties":{"x":{"type":"integer"},"y":{"type":"integer"},"z":{"type":"integer"},"face":{"type":"string","default":"Up"},"hand":{"type":"string","default":"MainHand"},"lookAtBlock":{"type":"boolean","default":false}},"required":["x","y","z"]}},{"name":"mcc_recent_events","description":"Get recent high-signal MCP runtime events after a given event ID.","inputSchema":{"type":"object","properties":{"afterId":{"type":"integer","default":0},"maxCount":{"type":"integer","default":50},"typeFilter":{"type":["string","null"],"default":null}}}},{"name":"mcc_player_stats","description":"Get current controlled player stats, orientation, and location.","inputSchema":{"type":"object","properties":{}}},{"name":"mcc_items_pickup","description":"Move to and pick up nearby dropped items of a given item type.","inputSchema":{"type":"object","properties":{"itemType":{"type":"string"},"radius":{"type":"number","default":32},"maxItems":{"type":"integer","default":20},"allowUnsafe":{"type":"boolean","default":false},"timeoutMs":{"type":"integer","default":0}},"required":["itemType"]}},{"name":"mcc_change_hotbar_slot","description":"Change active hotbar slot (1-9).","inputSchema":{"type":"object","properties":{"slot":{"type":"integer"}},"required":["slot"]}}]},"id":2,"jsonrpc":"2.0"}

