data: {"result":{"tools":[{"name":"mcc_agent_guidance","description":"Get the canonical MCC MCP Operator Prompt bundle for external agents using this MCP server.","inputSchema":{"type":"object","properties":{}}},{"name":"mcc_internal_commands_list","description":"List available MCC internal commands with usage and description.","inputSchema":{"type":"object","properties":{}}},{"name":"mcc_container_close","description":"Close an open non-player container. Use inventoryId=-1 to close the active container.","inputSchema":{"type":"object","properties":{"inventoryId":{"description":"Container inventory ID, or -1 for the active non-player container.","type":"integer","default":-1},"timeoutMs":{"type":"integer","default":0}}}},{"name":"mcc_inventory_search","description":"Search the player inventory and optionally open containers for items matching a query.","inputSchema":{"type":"object","properties":{"query":{"type":"string"},"maxCount":{"type":"integer","default":100},"exactMatch":{"type":"boolean","default":false},"includeContainers":{"type":"boolean","default":true}},"required":["query"]}},{"name":"mcc_animation","description":"Play a hand-swing animation with the selected hand.","inputSchema":{"type":"object","properties":{"hand":{"type":"string","default":"MainHand"}}}},{"name":"mcc_block_scan","description":"Scan nearby blocks around player location.","inputSchema":{"type":"object","properties":{"radius":{"type":"integer","default":3},"maxCount":{"type":"integer","default":200},"materialFilter":{"type":["string","null"],"default":null}}}},{"name":"mcc_entity_attack","description":"Attack a tracked entity explicitly.","inputSchema":{"type":"object","properties":{"entityId":{"type":"integer"}},"required":["entityId"]}},{"name":"mcc_move_to_player","description":"Locate a tracked player entity, request movement/pathing, and verify arrival.","inputSchema":{"type":"object","properties":{"playerName":{"type":"string"},"allowUnsafe":{"type":"boolean","default":false},"al