"type":"number"}},"required":["x","y","z"]}},{"name":"mcc_inventory_drop_item","description":"Drop an exact item count from an inventory by item type.","inputSchema":{"type":"object","properties":{"itemType":{"description":"Item type enum name (e.g. Diamond).","type":"string"},"count":{"description":"Exact number of items to drop.","type":"integer"},"inventoryId":{"description":"Inventory ID. 0 is the player inventory.","type":"integer","default":0},"preferStack":{"description":"Prefer dropping from larger stacks first when true.","type":"boolean","default":false}},"required":["itemType","count"]}},{"name":"mcc_move_to","description":"Request movement/pathing to a world coordinate and verify arrival.","inputSchema":{"type":"object","properties":{"x":{"type":"number"},"y":{"type":"number"},"z":{"type":"number"},"allowUnsafe":{"type":"boolean","default":false},"allowDirectTeleport":{"type":"boolean","default":false},"maxOffset":{"type":"integer","default":0},"minOffset":{"type":"integer","default":0},"timeoutMs":{"type":"integer","default":0}},"required":["x","y","z"]}},{"name":"mcc_session_status","description":"Get current MCC session and feature status.","inputSchema":{"type":"object","properties":{}}},{"name":"mcc_players_list","description":"List currently known online players.","inputSchema":{"type":"object","properties":{}}},{"name":"mcc_quit_client","description":"Quit MCC client process cleanly.","inputSchema":{"type":"object","properties":{}}},{"name":"mcc_entity_types_list","description":"List known MCC entity type names with optional filtering.","inputSchema":{"type":"object","properties":{"filter":{"type":["string","null"],"default":null},"maxCount":{"type":"integer","default":500}}}},{"name":"mcc_player_locate","description":"Locate a tracked player entity by name and return exact coordinates when available.","inputSchema":{"type":"object","properties":{"playerName":{"type":"string"},"includeSelf":{"type":"boolean","default":false}},"required":["playerName"]}},{"name":"mcc_inventories_list","description":"List currently open inventories and containers known to MCC.","inputSchema":{"type":"object","properties":{}}},{"name":"mcc_chunk_status","description":"Get chunk loading status for the player location or an explicit world coordinate.","inputSchema":{"type":"object","properties":{"x":{"type":["number","null"],"default":null},"y":{"type":["number","null"],"default":null},"z":{"type":["number","null"],"default":null}}}},{"name":"mcc_entity_interact","description":"Interact with a tracked entity.","inputSchema":{"type":"object","properties":{"entityId":{"type":"integer"},"interaction":{"type":"string","default":"Interact"},"hand":{"type":"string","default":"MainHand"}},"required":["entityId"]}},{"name":"mcc_respawn","description":"Send the respawn packet when the controlled player is dead.","inputSchema":{"type":"object","properties":{}}},{"name":"mcc_disconnect","description":"Disconnect MCC from the current server without quitting the process.","inputSchema":{"type":"object","properties":{}}},{"name":"mcc_players_detailed","description":"List online players with UUID, latency, gamemode, and tracked coordinates when available.","inputSchema":{"type":"object","properties":{"includeSelf":{"type":"boolean","default":false},"includeCoordinates":{"type":"boolean","default":true}}}},{"name":"mcc_server_info","description":"Get active MCC server connection info and current TPS.","inputSchema":{"type":"object","properties":{}}},{"name":"mcc_look_at","description":"Rotate player view toward world coordinates.","inputSchema":{"type":"object","properties":{"x":{"type":"number"},"y":{"type":"number"},"z":{"type":"number"}},"required":["x","y","z"]}},{"name":"mcc_block_types_list","description":"List known MCC block type names with optional filtering.","inputSchema":{"type":"object","properties":{"filter":{"type":["string","null"],"default":null},"maxCount":{"type":"integer","default":500}}}},{"name":"mcc_items_list","descriptio